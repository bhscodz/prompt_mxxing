# =====================================================================
# .env.example — SwasthyaGrid AI
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# =====================================================================

# ── Database (PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/swasthya_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=swasthya_db

# ── Security ──────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── District Context ──────────────────────────────────────────────────
DEFAULT_DISTRICT=Pune Rural & Western Ghats
DEFAULT_STATE=Maharashtra

# ── AI Agent (optional) ───────────────────────────────────────────────
# If not set, the agent falls back to template-based responses.
# OPENAI_API_KEY=sk-...

# ── Alert Thresholds ──────────────────────────────────────────────────
STOCKOUT_CRITICAL_THRESHOLD_DAYS=3.0
STOCKOUT_WARNING_THRESHOLD_DAYS=7.0
FORECAST_HORIZON_DAYS=14
TIME_SERIES_LOOKBACK_DAYS=90
